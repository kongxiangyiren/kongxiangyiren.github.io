{
  "name": "blog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-s \"build:compile\" \"verify:build\"",
    "preview": "vite preview",
    "build-only": "vite build",
    "build:compile": "run-p type-check \"build-only {@}\" --",
    "verify:build": "node scripts/verify-build.mjs",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@unhead/vue": "^3.4.0",
    "@vueuse/core": "^14.4.0",
    "element-plus": "^2.14.5",
    "fuse.js": "^7.5.0",
    "markdown-it": "^15.0.2",
    "nitro": "3.0.260903-beta",
    "pinia": "^4.0.2",
    "shiki": "^4.4.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@shikijs/markdown-it": "^4.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.4",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.73.0",
    "eslint-plugin-vue": "~10.9.2",
    "gray-matter": "^4.0.3",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.74.0",
    "prettier": "3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass-embedded": "~1.104.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "packageManager": "pnpm@12.4.1"
}
